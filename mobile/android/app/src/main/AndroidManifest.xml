<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- 이 휴대폰의 감지 화면 (detect/): 앱의 설정(이 휴대폰으로 감지하기)과 로그인 화면 아래(감지용 휴대전화 연결하기)에서 열림 -->
        <activity
            android:name=".detect.DetectorActivity"
            android:label="@string/detect_title"
            android:theme="@style/AppTheme.NoActionBar"
            android:exported="false" />

        <!-- 카메라 연속 프레임 → 낙상 판단 → 서버 전송. 카메라를 쓰는 포그라운드 서비스 (알림이 계속 보임) -->
        <service
            android:name=".detect.DetectionService"
            android:foregroundServiceType="camera"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 웹앱의 QR 초대 코드 인식 (WebView 카메라)과 감지 기기의 카메라. 카메라가 없는 기기에도 설치되도록 required=false -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- 감지 기기: 화면이 꺼져 있어도 카메라를 쓰는 포그라운드 서비스와 그 알림 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
