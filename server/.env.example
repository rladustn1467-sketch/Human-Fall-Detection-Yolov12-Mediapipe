# 서버 비밀 설정 예시 파일
# 이 파일을 복사해서 이름을 ".env" 로 바꾼 뒤 값을 채우세요. (server\.env)
# .env 는 .gitignore 에 들어 있어 GitHub 에 올라가지 않습니다. 이 예시 파일에는 실제 값을 넣지 마세요.
# 값이 비어 있으면 서버는 "텔레그램 설정 없음" 로그만 남기고 알림 없이 동작합니다.

# 텔레그램 봇 토큰 (@BotFather 에서 발급, 예: 123456789:AAH...)
TELEGRAM_BOT_TOKEN=

# 알림을 받을 채팅 ID (개인 채팅은 숫자, 그룹은 -로 시작하는 숫자)
TELEGRAM_CHAT_ID=

# (선택) 낙상 후 응답을 기다리는 시간(초). 기본값 60
# FALL_RESPONSE_TIMEOUT=60

# (선택) 직전 '도움 요청' 알림 후 이 시간(초) 안에 다시 누르면 중복으로 보고 알림 생략. 기본값 10
# HELP_ALERT_COOLDOWN=10
