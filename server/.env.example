# 서버 비밀 설정 예시 파일
# 이 파일을 복사해서 이름을 ".env" 로 바꾼 뒤 값을 채우세요. (server\.env)
# .env 는 .gitignore 에 들어 있어 GitHub 에 올라가지 않습니다. 이 예시 파일에는 실제 값을 넣지 마세요.
# 값이 비어 있으면 서버는 "텔레그램 설정 없음" 로그만 남기고 알림 없이 동작합니다.

# 텔레그램 봇 토큰 (@BotFather 에서 발급, 예: 123456789:AAH...)
TELEGRAM_BOT_TOKEN=

# 알림을 받을 보호자 채팅 ID (개인 채팅은 숫자, 그룹은 -로 시작하는 숫자)
# 보호자가 여러 명이면 쉼표로 구분 (예: 111111111,222222222)
TELEGRAM_CHAT_ID=

# 119 신고(시뮬레이션)에 넣을 주소와 연락처 (실제 119에는 연락하지 않습니다)
# 비어 있으면 '미등록'으로 표시됩니다
REPORT_ADDRESS=
REPORT_CONTACT=

# 현관 비번과 공동현관 비번 (신고 기록 웹페이지에만 표시, 텔레그램·기록 파일에는 남기지 않음)
# 비어 있으면 '미등록'으로 표시됩니다
DOOR_CODE=
BUILDING_DOOR_CODE=

# (선택) 낙상자 미확인일 때 신고에 의료 정보를 넣을지: exclude(제외, 기본) / all(거주자 전원 포함)
# REPORT_UNCONFIRMED_MEDICAL=exclude

# (선택) 거주자 정보 갱신일이 이 일수보다 오래되면 '정보가 오래됐을 수 있음' 표시. 기본값 180
# PROFILE_STALE_DAYS=180

# (선택) 신고 완료 텔레그램 알림의 '상세 보기' 버튼. 누른 보호자의 대화창에 주소·현관 비번·의료 정보를 답장
# true: 켜짐 (기본) / false: 꺼짐 (버튼이 사라짐). 진짜 정보를 넣을 때는 false 로 끄세요
# (텔레그램으로 보낸 내용은 텔레그램 서버와 휴대폰에 남습니다)
# SHOW_DETAIL_IN_TELEGRAM=true

# (선택) 휴대폰에서 열리는 서버 주소 (예: https://example.com). 있을 때만 신고 완료 알림에 웹 링크를 붙임
# 비어 있으면 링크 대신 '자세한 내용: 아래 상세 보기 버튼'으로 안내
PUBLIC_BASE_URL=

# (선택) 신고 기록 상세 페이지(주소·현관 비번·의료 정보) 접근 범위
# anywhere: 접속 토큰이 있으면 어디서나 (기본) / local: 이 PC에서만
# REPORT_PAGE_ACCESS=anywhere

# (선택) 무응답 알림 후 보호자가 아무 버튼도 누르지 않으면 자동 신고(시뮬레이션)까지의 시간(초). 기본값 180
# GUARDIAN_WAIT_AFTER_TIMEOUT=180

# (선택) 본인 '도움이 필요해요' 알림 후 보호자 대기 시간(초). 기본값 90
# GUARDIAN_WAIT_AFTER_HELP=90

# (선택) 낙상 후 응답을 기다리는 시간(초). 기본값 60
# FALL_RESPONSE_TIMEOUT=60

# (선택) 직전 '도움 요청' 알림 후 이 시간(초) 안에 다시 누르면 중복으로 보고 알림 생략. 기본값 10
# HELP_ALERT_COOLDOWN=10
