# 낙상 감지 서버 HTTPS 리버스 프록시 (Caddy 2.8 이상). 복사해서 Caddyfile 로 쓰고, 아래 두 값을 환경 변수로 줌:
#   FD_DOMAIN     이 서버에 연결한 도메인 (예: fall.example.com) — 도메인의 A 레코드가 이 컴퓨터의 공인 IP 를 가리켜야 함
#   FD_ACME_EMAIL 인증서 발급·갱신 안내를 받을 이메일
# Caddy 가 Let's Encrypt 인증서를 자동으로 받고 갱신함 (80·443 포트가 밖에서 열려 있어야 함).
# 낙상 감지 서버는 run_server_behind_proxy.bat 으로 127.0.0.1:8000 에서만 실행.
# 이 파일은 아직 실제 Caddy 로 검사하지 않았음: 적용 전에 `caddy validate --config Caddyfile` 로 확인 (README 참고)

{
	email {$FD_ACME_EMAIL}
}

{$FD_DOMAIN} {
	encode gzip

	header {
		# 브라우저가 앞으로 이 도메인을 HTTPS 로만 열게 함 (처음 적용은 짧게 시험한 뒤 늘리는 것을 권장)
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# 사진은 최대 약 1.4MB(base64): 넉넉히 4MB 까지만 받음
	request_body {
		max_size 4MB
	}

	# Caddy 는 X-Forwarded-For / X-Forwarded-Proto / Host 를 그대로 넘김 → 서버가 HTTPS·실제 주소를 앎
	reverse_proxy 127.0.0.1:8000

	# 접속 기록: 토큰·쿠키·인증 헤더는 기록하지 않음 (옛 관리자 로그인 주소의 ?token= 도 가림)
	log {
		output file logs/caddy-access.log {
			roll_size 10MiB
			roll_keep 5
		}
		format filter {
			request>uri query {
				replace token ***
			}
			request>headers>Authorization delete
			request>headers>Cookie delete
			request>headers>X-Access-Token delete
			resp_headers>Set-Cookie delete
		}
	}
}
