# 학교 서버용 설정 예시. 복사해서 .env 로 만들고 값을 채웁니다. .env 는 GitHub 에 올리지 않습니다.

# 학교 서버의 앞단 프록시를 믿음: 접속한 사람의 실제 주소로 로그인·가입 횟수를 제한함
FORWARDED_ALLOW_IPS=*

# 로그인 쿠키를 HTTPS 로만 보냄
SESSION_COOKIE_SECURE=true

# 신고 기록 상세 페이지는 밖에서 열지 않음
REPORT_PAGE_ACCESS=local

# 현관 비밀번호 암호화 키. 비어 있으면 현관 비밀번호를 저장하지 않음
# 만들기: ~/.venv/bin/python door_codes.py genkey
DOOR_CODE_KEY=

# (선택) 주소 검색 키. 비어 있으면 주소를 직접 입력함
JUSO_API_KEY=
